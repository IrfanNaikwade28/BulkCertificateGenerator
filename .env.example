# Copy to .env and adjust for your local environment.
# Never commit a real .env file.
#
# Local development values below point at the docker-compose PostgreSQL.
# In production (Render), set DATABASE_URL in the Render dashboard to your
# Neon connection string — it is never written to this repository.
# postgres:// and postgresql:// URLs are normalized automatically.

DATABASE_URL=postgresql+psycopg://certgen:certgen@localhost:5432/certgen
MAX_BATCH_SIZE=100
STORAGE_DIR=storage/certificates
LOG_LEVEL=INFO
